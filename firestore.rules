rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null
        && request.auth.uid == "8XUYgcBGMSTIGVDVXn6doSoLhw02";
    }

    match /{collection}/{recordId} {
      allow read: if isAuthorizedUser()
        && collection in ["businesses", "clients", "products", "invoices", "invoice_payments"]
        && resource.data.user_id == request.auth.uid;
      allow create: if isAuthorizedUser()
        && collection in ["businesses", "clients", "products", "invoices", "invoice_payments"]
        && request.resource.data.user_id == request.auth.uid;
      allow update: if isAuthorizedUser()
        && collection in ["businesses", "clients", "products", "invoices", "invoice_payments"]
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
      allow delete: if isAuthorizedUser()
        && collection in ["businesses", "clients", "products", "invoices", "invoice_payments"]
        && resource.data.user_id == request.auth.uid;
    }
  }
}
